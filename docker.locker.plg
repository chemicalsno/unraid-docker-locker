<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name    "docker.locker">
<!ENTITY author  "chemicalsno">
<!ENTITY version "2026.10.25a">
<!ENTITY repo    "chemicalsno/unraid-docker-locker">
<!ENTITY plgPATH "/boot/config/plugins/&name;">
<!ENTITY emhttp  "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        pluginURL="https://raw.githubusercontent.com/&repo;/main/&name;.plg"
        support="https://github.com/&repo;/issues"
        icon="&name;.png"
        min="7.3.0">

<CHANGES>
###2026.10.25a
- Update All counts every locked container, not only those with an update waiting
- Hovering over Update All lists the locked containers it skips

###2026.10.25
- Initial release
- Lock toggle on each container in Docker > Docker Containers
- Update All skips locked containers
- Updating a locked container from the Docker page or the Dashboard asks first
- Update All and single updates re-read the lock list first, so locks set in another tab apply
- A warning banner appears if a future Unraid release changes the Docker page so locks can't apply
</CHANGES>

<!-- The installer never overwrites existing files, so clear out the previous version first -->
<FILE Run="/bin/bash">
<INLINE>
rm -rf "&emhttp;"
mkdir -p "&plgPATH;"
</INLINE>
</FILE>

<!-- Buttons pages are evaluated in the head of every webGUI page, which is how the script reaches the Docker page -->
<FILE Name="&emhttp;/DockerLocker.page">
<INLINE><![CDATA[
Menu="Buttons"
Link="docker-locker"
---
<?
$lockerList = @json_decode(@file_get_contents('/boot/config/plugins/docker.locker/locked.json'), true);
?>
<script>
var dockerLocker = <?=json_encode(is_array($lockerList) ? array_values($lockerList) : [], JSON_HEX_TAG|JSON_HEX_AMP)?>;
var dockerLockerRunning = <?=is_file('/var/run/dockerd.pid') ? 'true' : 'false'?>;
</script>
<script src="<?autov('/plugins/docker.locker/javascript/lock.js')?>"></script>
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/include/Lock.php">
<INLINE><![CDATA[
<?PHP
/* Docker Locker - lock list endpoint
 *
 * GET returns the locked container names as a JSON array.
 * POST name=<container>&locked=0|1 changes one lock and returns the new list.
 */
$file = '/boot/config/plugins/docker.locker/locked.json';

header('Content-Type: application/json');

$locked = @json_decode(@file_get_contents($file), true);
if (!is_array($locked)) $locked = [];

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
  $name = $_POST['name'] ?? '';
  // Docker's own container name rule
  if (!preg_match('/^[a-zA-Z0-9][a-zA-Z0-9_.-]*$/', $name)) {
    http_response_code(400);
    echo json_encode(['error' => 'invalid container name']);
    exit;
  }
  $locked = array_values(array_diff($locked, [$name]));
  if (!empty($_POST['locked'])) $locked[] = $name;
  sort($locked);
  if (!is_dir(dirname($file))) mkdir(dirname($file), 0777, true);
  // write then rename so a power cut can't leave a half-written list on the flash drive
  if (file_put_contents("$file.tmp", json_encode($locked)) === false || !rename("$file.tmp", $file)) {
    http_response_code(500);
    echo json_encode(['error' => 'unable to save lock list']);
    exit;
  }
}
echo json_encode($locked);
?>
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/javascript/lock.js">
<INLINE><![CDATA[
/* Docker Locker
 *
 * Keeps locked containers out of the Docker page's "Update All", and asks before
 * updating a locked container on its own from the Docker page or the Dashboard.
 * It replaces the stock updateAll() and updateContainer() from
 * dynamix.docker.manager/javascript/docker.js, so it first checks that those still
 * look like the Unraid 7.3 versions it was written against.
 */
(function($) {
  'use strict';
  var endpoint = '/plugins/docker.locker/include/Lock.php';
  var listURL = '/plugins/dynamix.docker.manager/include/DockerContainers.php';
  var locked = new Set(window.dockerLocker || []);
  var hooked = false, warned = false, stockUpdateContainer, label;

  function t(text) {
    return typeof window._ == 'function' ? window._(text) : text;
  }

  // our updateAll() is the stock one plus a filter, so only take over while the
  // stock one still picks containers the same way
  function stockMatches() {
    var src = String(window.updateAll);
    return typeof window.updateAll == 'function' && typeof window.openDocker == 'function' &&
      Array.isArray(window.docker) && /d\.update\s*==\s*1/.test(src) && src.indexOf("'update_container '") >= 0;
  }

  function stockUpdateContainerMatches() {
    return typeof window.updateContainer == 'function' && typeof window.openDocker == 'function' &&
      String(window.updateContainer).indexOf("'update_container '") >= 0;
  }

  // another tab may have changed the locks since this page loaded
  function refresh(then, failed) {
    $.ajax({url:endpoint, dataType:'json', cache:false}).done(function(list) {
      locked = new Set(list);
      then();
    }).fail(function() {
      swal({title:t('Error'),text:t('Unable to read the lock list. Nothing was updated.'),type:'error'});
      if (failed) failed();
    });
  }

  // the button counts every lock on the page, not just locked containers with an
  // update waiting, so the number matches what the user remembers locking
  function pending() {
    var result = {update:[], locked:[]};
    for (var i=0,d; d=window.docker[i]; i++) {
      if (locked.has(d.name)) result.locked.push(d.name);
      else if (d.update==1) result.update.push(d.name);
    }
    return result;
  }

  function updateAll() {
    $('input[type=button]').prop('disabled',true);
    refresh(function() {
      var p = pending();
      // a reload redraws the rows and re-enables the buttons
      if (!p.update.length) return window.loadlist();
      var title = t('Updating all Containers')+(p.locked.length ? ' ('+p.locked.length+' '+t('locked')+')' : '');
      window.openDocker('update_container '+p.update.map(encodeURIComponent).join('*'),title,'','loadlist');
    },function() {
      window.loadlist();
    });
  }

  function updateContainer(container) {
    refresh(function() {
      if (!locked.has(container)) return stockUpdateContainer(container);
      swal({
        title:t('Container is locked'),text:container+': '+t('this container is locked against updates. Update it anyway?'),type:'warning',
        showCancelButton:true,closeOnConfirm:false,confirmButtonText:t('Update anyway'),cancelButtonText:t('Cancel')
      },function(){
        window.openDocker('update_container '+encodeURIComponent(container),t('Updating the container'),'','loadlist');
      });
    });
  }

  function decorate() {
    for (var i=0,d; d=window.docker[i]; i++) {
      // each row holds a span whose id is the container id
      var cell = $(document.getElementById(d.id)).closest('tr').children('td.updatecolumn');
      if (!cell.length) continue;
      var on = locked.has(d.name);
      // a.exec sets its own color, so the color class goes on the contents
      var color = on ? 'orange-text' : 'grey-text';
      var link = $('<a class="exec locker-toggle"></a>').attr('data-name',d.name)
        .attr('title',on ? t('Skipped by Update All. Click to unlock.') : t('Click to lock so Update All skips it'))
        .append($('<i class="fa fa-fw"></i>').addClass(on ? 'fa-lock' : 'fa-unlock-alt').addClass(color),' ',$('<span></span>').addClass(color).text(on ? t('locked') : t('lock')));
      cell.children('.locker').remove();
      cell.append($('<div class="locker" style="white-space:nowrap"></div>').append(link));
    }
  }

  function syncButton() {
    var btn = $('input#updateAll');
    if (!btn.length) return;
    if (label === undefined) label = btn.val();
    if (!hooked) {
      // can't filter on this Unraid version, so keep Update All away from locked containers
      if (locked.size) btn.prop('disabled',true).attr('title',t('Docker Locker does not support this Unraid version. Update All is disabled while containers are locked.'));
      return;
    }
    var p = pending();
    btn.val(p.locked.length ? label+' ('+p.locked.length+' '+t('locked')+')' : label);
    btn.attr('title',p.locked.length ? t('Skips locked containers')+': '+p.locked.join(', ') : '');
    btn.prop('disabled',!p.update.length);
  }

  // if the Docker page has changed so the hooks didn't take, locks do nothing,
  // and that must not go unnoticed
  function warnIfUnprotected() {
    if (warned || !locked.size || !window.dockerLockerRunning || !/^\/Docker(\/|$)/.test(location.pathname)) return;
    if (hooked && stockUpdateContainer) return;
    warned = true;
    var text = t('Docker Locker does not support this version of Unraid, so locked containers may still be updated from this page.');
    // no dismiss button: dismissing sets a cookie that hides the banner for good
    if (typeof window.addBannerWarning == 'function') window.addBannerWarning(text,true,true);
    else $('body').prepend($('<div class="locker-banner orange-text" style="padding:8px 16px;font-weight:bold"></div>').text(text));
  }

  $(document).on('click','a.locker-toggle',function() {
    var name = $(this).attr('data-name');
    $.post(endpoint,{name:name,locked:locked.has(name) ? 0 : 1},function(list) {
      locked = new Set(list);
      decorate();
      syncButton();
      warnIfUnprotected();
    },'json').fail(function() {
      swal({title:t('Error'),text:t('Unable to save the lock for')+' '+name,type:'error'});
    });
  });

  // global ajaxSuccess fires after the page's own callback has rendered the list
  $(document).ajaxSuccess(function(e,xhr,settings) {
    if (settings.url.indexOf(listURL) >= 0) {
      decorate();
      syncButton();
    }
  });

  $(function() {
    // the Dashboard loads docker.js too, and its container menu offers Update
    if (stockUpdateContainerMatches()) {
      stockUpdateContainer = window.updateContainer;
      window.updateContainer = updateContainer;
    }
    if (!$('input#updateAll').length) return warnIfUnprotected();
    if (stockMatches()) {
      window.updateAll = updateAll;
      hooked = true;
    }
    warnIfUnprotected();
    // the list may have loaded before this ran
    decorate();
    syncButton();
  });
})(jQuery);
]]></INLINE>
</FILE>

