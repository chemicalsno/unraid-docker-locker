<FILE Run="/bin/bash">
<INLINE>
echo ""
echo "----------------------------------------------------"
echo " &name; has been installed."
echo " Version: &version;"
echo " Lock containers from Docker > Docker Containers."
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- The lock list in &plgPATH; is kept so a reinstall restores it -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
rm -rf "&emhttp;"
echo "&name; has been removed."
</INLINE>
</FILE>

</PLUGIN>
